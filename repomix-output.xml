    OUTPUT_FORMATS = ["Same as source", "JPEG", "PNG", "TIFF", "HEIC"]
    SOURCE_FORMATS = {
        ".jpg": "JPEG",
        ".jpeg": "JPEG",
        ".jpe": "JPEG",
        ".jfif": "JPEG",
        ".png": "PNG",
        ".tif": "TIFF",
        ".tiff": "TIFF",
        ".heic": "HEIC",
        ".heif": "HEIC",
    }

    # MetadataOptions uses user-facing labels, while MetadataProcessor checks
    # lower-case internal keys (e.g. "gps", not "gps location").
    METADATA_KEYS = {
        "EXIF": "exif",
        "GPS Location": "gps",
        "IPTC": "iptc",
        "XMP": "xmp",
