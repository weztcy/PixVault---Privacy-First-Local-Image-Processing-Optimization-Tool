from pathlib import Path

from PIL import Image

from formats import BaseEncoder




class ICOEncoder(BaseEncoder):


    def save(
        self,
        image,
        output_path,
        settings
    ):


        output = Path(
            output_path
        )


        sizes = settings.get(
            "sizes",
            [
                16,
                32,
                48,
                64,
                128,
                256
            ]
        )


        bit_depth = settings.get(
            "bit_depth",
            32
        )


