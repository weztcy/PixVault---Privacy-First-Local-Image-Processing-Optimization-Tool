from pathlib import Path

from PIL import Image

from formats import BaseEncoder




class BMPEncoder(BaseEncoder):


    def save(
        self,
        image,
        output_path,
        settings
    ):


        output = Path(
            output_path
        )


        bit_depth = settings.get(
            "bit_depth",
            24
        )


        alpha = settings.get(
            "alpha",
            False
        )


        prepared = self.prepare_image(
            image,
            bit_depth,
            alpha
        )


        prepared.save(
            output,
            format="BMP"
        )


        return output




    def prepare_image(
        self,
        image,
        bit_depth,
        alpha
    ):


        # =====================
        # 32 BIT
        # =====================

        if bit_depth == 32:


            if alpha:


                return image.convert(
                    "RGBA"
                )


            else:


                return image.convert(
                    "RGB"
                )



        # =====================
        # 24 BIT
        # =====================

        if bit_depth == 24:


            return image.convert(
                "RGB"
            )



        # =====================
        # 16 BIT
        # =====================

        if bit_depth == 16:


            return self.convert_16bit(
                image
            )



        # =====================
        # 8 BIT
        # =====================

        if bit_depth == 8:


            return image.convert(
                "P",
                colors=256
            )



        # =====================
        # 4 BIT
        # =====================

        if bit_depth == 4:


            return image.convert(
                "P",
                colors=16
            )



        # =====================
        # 1 BIT
        # =====================

        if bit_depth == 1:


            return image.convert(
                "1"
            )



        return image.convert(
            "RGB"
        )




    def convert_16bit(
        self,
        image
    ):


        """
        BMP 16-bit RGB565 approximation.
        Pillow BMP writer tidak menyediakan
        kontrol bitmask penuh melalui save().
        """


        image = image.convert(
            "RGB"
        )


        return image
