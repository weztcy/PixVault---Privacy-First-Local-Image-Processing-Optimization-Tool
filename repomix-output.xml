from pathlib import Path

from PIL import Image, ImageCms





class ColorSpaceProcessor:



    def process(
        self,
        source_path,
        output_path,
        settings
    ):


        source = Path(
            source_path
        )


        output = Path(
            output_path
        )


        output.parent.mkdir(
            parents=True,
            exist_ok=True
        )



        if not source.exists():

            raise FileNotFoundError(
                f"Source image not found: {source}"
            )



        target = settings.get(
            "target",
            "sRGB"
        )



        with Image.open(source) as image:


            converted = self.convert_colorspace(

                image,

                target

            )



            save_settings = {

                "format": "TIFF",

                "compression": "tiff_lzw"

            }



            icc = converted.info.get(
                "icc_profile"
            )



            if icc:

                save_settings[
                    "icc_profile"
                ] = icc



            converted.save(

                output,

                **save_settings

            )



        return output







    def convert_colorspace(
        self,
        image,
        target
    ):


        target = str(
            target
        ).lower()



        if target in [

            "srgb",

            "rgb"

        ]:

            return self.to_srgb(
                image
            )



        if target in [

            "grayscale",

            "gray",

            "greyscale"

        ]:

            return self.to_grayscale(
                image
            )



        if target == "cmyk":

            return self.to_cmyk(
                image
            )



        raise ValueError(

            f"Unsupported color space: {target}"

        )








    def to_srgb(
        self,
        image
    ):


        rgb = image.convert(
            "RGB"
        )


        profile = ImageCms.createProfile(
            "sRGB"
        )


        rgb.info[
            "icc_profile"
        ] = (

            ImageCms.ImageCmsProfile(
                profile
            ).tobytes()

        )


        return rgb








    def to_grayscale(
        self,
        image
    ):


        gray = image.convert(
            "L"
        )


        return gray








    def to_cmyk(
        self,
        image
    ):


        cmyk = image.convert(
            "CMYK"
        )


        return cmyk
