from pathlib import Path

from PIL import Image

from formats import BaseEncoder




class PNGEncoder(BaseEncoder):


    def save(
        self,
        image,
        output_path,
        settings
    ):


        output = Path(
            output_path
        )



        # =====================
        # SETTINGS
        # =====================


        compression = settings.get(
            "compression",
            6
        )


        interlace = settings.get(
            "interlace",
            False
        )


        bit_depth = settings.get(
            "bit_depth",
            8
        )


        color_type = settings.get(
            "color_type",
            "RGBA"
        )



        # =====================
        # VALIDATE COMPRESSION
        # =====================


        compression = max(
            0,
            min(
                9,
                int(compression)
            )
        )



        # =====================
        # COLOR TYPE
        # =====================


        if color_type == "RGBA":


            if image.mode != "RGBA":

                image = image.convert(
                    "RGBA"
                )



        elif color_type == "RGB":


            if image.mode != "RGB":

                image = image.convert(
                    "RGB"
                )



        elif color_type == "Grayscale":


            if image.mode != "L":

                image = image.convert(
                    "L"
                )



        else:


            image = image.convert(
                "RGBA"
            )



        # =====================
        # BIT DEPTH
        # =====================
        #
        # Pillow:
        #
        # 8-bit:
        #   RGB
        #   RGBA
        #   L
        #
        # 16-bit:
        #   I;16
        #
        # =====================


        if int(bit_depth) == 16:


            if color_type == "Grayscale":


                image = image.convert(
                    "I;16"
                )


            else:


                # Pillow PNG 16-bit RGB/RGBA
                # menggunakan channel 16 bit
                image = image.point(
                    lambda p: p * 257
                )



        else:


            if image.mode == "I;16":

                image = image.convert(
                    "L"
                )



        # =====================
        # SAVE PNG
        # =====================


        image.save(

            output,

            format="PNG",

            compress_level=compression,

            interlace=bool(
                interlace
            )

        )


        return output
