def get_capabilities(format_name):

    return FORMAT_CAPABILITIES.get(format_name.upper(), {})


def supports(format_name, feature):

    capabilities = get_capabilities(format_name)

    return bool(capabilities.get(feature, False))


def get_supported_values(format_name, feature):

    capabilities = get_capabilities(format_name)

    return capabilities.get(feature, [])
