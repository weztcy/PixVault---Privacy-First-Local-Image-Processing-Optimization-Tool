from pathlib import Path

from PIL import Image





class ImageCompressor:



    def process(
        self,
        source_path,
        output_path,
        settings
    ):


        source = Path(
            source_path
        )


        output = Path(
            output_path
        )


        output.parent.mkdir(
            parents=True,
            exist_ok=True
        )



        if not source.exists():

            raise FileNotFoundError(
                f"Source image not found: {source}"
            )



        with Image.open(source) as image:


            compressed = self.compress_image(
                image,
                settings
            )


            compressed.save(

                output,

                format="TIFF",

                compression="tiff_lzw"

            )



        return output







    def compress_image(
        self,
        image,
        settings
    ):


        method = settings.get(
            "method",
            "none"
        )



        # =====================
        # NONE
        # =====================

        if method == "none":

            return image.copy()






        # =====================
        # OPTIMIZE
        # =====================

        if method == "optimize":

            optimized = image.copy()

            optimized.info.clear()

            return optimized






        # =====================
        # REMOVE ALPHA
        # =====================

        if method == "remove_alpha":


            return self.remove_alpha(
                image
            )








        # =====================
        # TARGET SIZE
        # =====================

        if method == "target_size":


            return self.resize_target(
                image,
                settings
            )








        raise ValueError(
            f"Unsupported compression method: {method}"
        )







    def remove_alpha(
        self,
        image
    ):


        if image.mode in [

            "RGBA",

            "LA"

        ]:


            background = Image.new(

                "RGB",

                image.size,

                "white"

            )


            background.paste(

                image,

                mask=image.getchannel(
                    "A"
                )

            )


            return background



        return image.copy()







    def resize_target(
        self,
        image,
        settings
    ):


        max_width = settings.get(
            "max_width"
        )


        max_height = settings.get(
            "max_height"
        )



        if not max_width and not max_height:

            raise ValueError(
                "Target size requires max_width or max_height"
            )



        width, height = image.size



        ratio = 1



        if max_width:

            ratio = min(
                ratio,
                max_width / width
            )



        if max_height:

            ratio = min(
                ratio,
                max_height / height
            )



        if ratio >= 1:

            return image.copy()



        return image.resize(

            (

                int(width * ratio),

                int(height * ratio)

            ),

            Image.Resampling.LANCZOS

        )
