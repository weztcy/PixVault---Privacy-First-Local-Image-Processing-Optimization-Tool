            QStackedWidget#main_workspace {
                background-color: #0b1120;
                border: none;
            }

            /* =========================
               PREMIUM HEADER
            ========================= */

            QFrame#main_header {
                background-color: #101b2d;

                border: none;
                border-bottom: 1px solid #29374c;
