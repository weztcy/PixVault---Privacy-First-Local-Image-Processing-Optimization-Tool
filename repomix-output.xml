from pathlib import Path

from PIL import Image





class ImageCropper:



    def process(
        self,
        source_path,
        output_path,
        settings
    ):


        source = Path(
            source_path
        )


        output = Path(
            output_path
        )


        output.parent.mkdir(
            parents=True,
            exist_ok=True
        )



        if not source.exists():

            raise FileNotFoundError(
                f"Source image not found: {source}"
            )



        with Image.open(source) as image:


            cropped = self.crop_image(
                image,
                settings
            )


            cropped.save(

                output,

                format="TIFF",

                compression="tiff_lzw"

            )



        return output







    def crop_image(
        self,
        image,
        settings
    ):


        mode = settings.get(
            "mode"
        )


        if not mode:

            raise ValueError(
                "Crop mode missing"
            )



        width, height = image.size



        crop_width = None

        crop_height = None






        # =====================
        # FIXED
        # =====================


        if mode == "fixed":


            crop_width = settings.get(
                "width"
            )


            crop_height = settings.get(
                "height"
            )


            if not crop_width or not crop_height:

                raise ValueError(
                    "Crop size missing"
                )



            if crop_width > width or crop_height > height:

                raise ValueError(
                    "Crop size exceeds image size"
                )








        # =====================
        # PERCENTAGE
        # =====================


        elif mode == "percentage":


            value = settings.get(
                "value",
                100
            )


            if value <= 0 or value > 100:

                raise ValueError(
                    "Crop percentage must be between 1-100"
                )


            percent = value / 100



            crop_width = int(
                width * percent
            )


            crop_height = int(
                height * percent
            )








        # =====================
        # ASPECT RATIO
        # =====================


        elif mode == "aspect_ratio":


            ratio = settings.get(
                "ratio",
                "1:1"
            )


            try:

                ratio_w, ratio_h = map(
                    int,
                    ratio.split(":")
                )


            except Exception:

                raise ValueError(
                    f"Invalid crop ratio: {ratio}"
                )



            if ratio_w <= 0 or ratio_h <= 0:

                raise ValueError(
                    "Invalid ratio value"
                )



            target_ratio = (
                ratio_w /
                ratio_h
            )


            current_ratio = (
                width /
                height
            )



            if current_ratio > target_ratio:


                crop_width = int(
                    height * target_ratio
                )


                crop_height = height



            else:


                crop_width = width


                crop_height = int(
                    width / target_ratio
                )








        # =====================
        # COORDINATE
        # =====================


        elif mode == "coordinates":


            left = max(
                0,
                int(settings.get("x", 0))
            )


            top = max(
                0,
                int(settings.get("y", 0))
            )


            crop_width = settings.get(
                "width"
            )


            crop_height = settings.get(
                "height"
            )



            if not crop_width or not crop_height:

                raise ValueError(
                    "Coordinate crop size missing"
                )


            right = min(
                left + crop_width,
                width
            )


            bottom = min(
                top + crop_height,
                height
            )


            if right <= left or bottom <= top:

                raise ValueError(
                    "Invalid crop coordinates"
                )


            return image.crop(
                (
                    left,
                    top,
                    right,
                    bottom
                )
            )








        else:

            raise ValueError(
                f"Unsupported crop mode: {mode}"
            )






        crop_width = int(
            crop_width
        )


        crop_height = int(
            crop_height
        )



        if crop_width < 1 or crop_height < 1:

            raise ValueError(
                "Crop result is empty"
            )



        left = (
            width - crop_width
        ) // 2



        top = (
            height - crop_height
        ) // 2



        right = left + crop_width


        bottom = top + crop_height



        return image.crop(
            (
                left,
                top,
                right,
                bottom
            )
        )
