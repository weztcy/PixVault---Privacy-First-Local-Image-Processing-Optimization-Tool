from pathlib import Path

from PIL import Image

from formats import BaseEncoder




class TIFFEncoder(BaseEncoder):


    def save(
        self,
        image,
        output_path,
        settings
    ):


        output = Path(
            output_path
        )


        compression = settings.get(
            "compression",
            "LZW"
        )


        bit_depth = settings.get(
            "bit_depth",
            8
        )


        color = settings.get(
            "color",
            "RGB"
        )


        dpi = settings.get(
            "dpi",
            300
        )


        quality = settings.get(
            "quality",
            85
        )



        image = self.prepare_image(
            image,
            color,
            bit_depth
        )



        save_settings = {


            "format":
                "TIFF",


            "compression":
                self.get_compression(
                    compression
                ),


            "dpi":
                (
                    dpi,
                    dpi
                )

        }



        if compression == "JPEG":

            save_settings[
                "quality"
            ] = quality



        image.save(
            output,
            **save_settings
        )


        return output




    def get_compression(
        self,
        compression
    ):


        mapping = {


            "None":
                None,


            "LZW":
                "tiff_lzw",


            "Deflate":
                "tiff_adobe_deflate",


            "PackBits":
                "packbits",


            "JPEG":
                "jpeg"

        }


        return mapping.get(
            compression,
            "tiff_lzw"
        )




    def prepare_image(
        self,
        image,
        color,
        bit_depth
    ):


        # =====================
        # COLOR
        # =====================


        if color == "RGBA":


            image = image.convert(
                "RGBA"
            )


        elif color == "RGB":


            image = image.convert(
                "RGB"
            )


        elif color == "Grayscale":


            image = image.convert(
                "L"
            )


        elif color == "CMYK":


            image = image.convert(
                "CMYK"
            )



        # =====================
        # BIT DEPTH
        # =====================


        if bit_depth == 8:


            return image



        if bit_depth == 16:


            return self.convert_16bit(
                image
            )



        if bit_depth == 32:


            return self.convert_32bit(
                image
            )



        return image




    def convert_16bit(
        self,
        image
    ):


        """
        TIFF mendukung 16-bit.
        Pillow menggunakan mode I;16
        untuk grayscale.
        """


        if image.mode == "L":


            return image.convert(
                "I;16"
            )


        return image




    def convert_32bit(
        self,
        image
    ):


        """
        TIFF 32-bit float/integer
        membutuhkan mode khusus.
        Untuk kompatibilitas,
        gunakan RGB biasa.
        """


        return image.convert(
            "RGB"
        )
