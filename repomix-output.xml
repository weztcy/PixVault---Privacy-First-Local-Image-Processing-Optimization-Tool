from pathlib import Path


from formats.encoder import EncoderManager

from export.naming import NamingEngine






class Exporter:



    def __init__(
        self
    ):


        self.encoder = EncoderManager()

        self.naming = NamingEngine()







    def export(
        self,
        image,
        source_path,
        output_folder,
        settings
    ):


        if not settings:

            raise ValueError(
                "Export settings missing"
            )



        output_folder = Path(
            output_folder
        )


        output_folder.mkdir(
            parents=True,
            exist_ok=True
        )



        format_name = settings.get(
            "format"
        )


        if not format_name:

            raise ValueError(
                "Output format missing"
            )



        # =====================
        # NORMALIZE FORMAT
        # =====================


        format_name = self.encoder.normalize_format(

            format_name

        )



        export_settings = dict(
            settings
        )


        export_settings["format"] = format_name






        # =====================
        # CREATE PATH
        # =====================


        output_path = self.naming.generate(

            source_path,

            output_folder,

            export_settings

        )



        output_path = Path(
            output_path
        )






        # =====================
        # ENCODE
        # =====================


        try:


            result = self.encoder.save(

                image,

                output_path,

                export_settings

            )


        except Exception as error:


            raise RuntimeError(

                f"Failed exporting {format_name}: {error}"

            ) from error





        result = Path(
            result
        )





        if not result.exists():


            raise RuntimeError(

                f"Encoder did not create output file: {result}"

            )





        # =====================
        # RETURN RESULT
        # =====================


        return {


            "path":

                result,


            "format":

                format_name,


            "size":

                result.stat().st_size

        }
