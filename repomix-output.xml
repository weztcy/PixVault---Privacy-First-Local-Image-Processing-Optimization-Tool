from pathlib import Path

from PIL import Image





class ImageTransformer:



    def process(
        self,
        source_path,
        output_path,
        settings
    ):


        source = Path(
            source_path
        )


        output = Path(
            output_path
        )


        output.parent.mkdir(
            parents=True,
            exist_ok=True
        )



        if not source.exists():

            raise FileNotFoundError(
                f"Source image not found: {source}"
            )



        with Image.open(source) as image:


            transformed = self.apply_transform(
                image,
                settings
            )


            transformed.save(

                output,

                format="TIFF",

                compression="tiff_lzw"

            )



        return output







    def apply_transform(
        self,
        image,
        settings
    ):


        rotation = settings.get(
            "rotation",
            "none"
        )


        flip = settings.get(
            "flip",
            "none"
        )



        # =====================
        # ROTATION
        # =====================


        if rotation != "none":


            try:

                angle = int(
                    rotation
                )


            except (ValueError, TypeError):

                raise ValueError(
                    f"Invalid rotation value: {rotation}"
                )



            angle = angle % 360



            if angle != 0:


                image = image.rotate(

                    -angle,

                    expand=True

                )






        # =====================
        # FLIP
        # =====================


        if flip == "horizontal":


            image = image.transpose(

                Image.Transpose.FLIP_LEFT_RIGHT

            )



        elif flip == "vertical":


            image = image.transpose(

                Image.Transpose.FLIP_TOP_BOTTOM

            )



        elif flip == "both":


            image = image.transpose(

                Image.Transpose.FLIP_LEFT_RIGHT

            )


            image = image.transpose(

                Image.Transpose.FLIP_TOP_BOTTOM

            )



        elif flip != "none":


            raise ValueError(
                f"Unsupported flip mode: {flip}"
            )



        return image
