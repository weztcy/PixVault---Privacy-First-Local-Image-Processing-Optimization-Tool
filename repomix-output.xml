from pathlib import Path

from PIL import Image

from formats import BaseEncoder




class GIFEncoder(BaseEncoder):


    def save(
        self,
        image,
        output_path,
        settings
    ):


        output = Path(
            output_path
        )



        # =====================
        # SETTINGS
        # =====================


        colors = settings.get(
            "colors",
            256
        )


        dithering = settings.get(
            "dithering",
            "floyd"
        )


        transparency = settings.get(
            "transparency",
            True
        )


        animation = settings.get(
            "animation",
            False
        )


        loop_mode = settings.get(
            "loop",
            "infinite"
        )


        duration = settings.get(
            "duration",
            100
        )



        frames = settings.get(
            "frames",
            None
        )



        # =====================
        # VALIDATION
        # =====================


        colors = max(
            2,
            min(
                256,
                int(colors)
            )
        )



        duration = max(
            10,
            int(duration)
        )



        # =====================
        # DITHERING
        # =====================


        if dithering == "none":

            dither = Image.Dither.NONE


        else:

            dither = Image.Dither.FLOYDSTEINBERG



        # =====================
        # CONVERT FRAME
        # =====================


        def prepare_frame(
            frame
        ):


            if frame.mode != "RGBA":

                frame = frame.convert(
                    "RGBA"
                )



            if transparency:


                frame = frame.convert(
                    "P",
                    colors=colors,
                    dither=dither
                )


                frame.info[
                    "transparency"
                ] = 0



            else:


                frame = frame.convert(
                    "P",
                    colors=colors,
                    dither=dither
                )



            return frame



        # =====================
        # ANIMATION
        # =====================


        if animation and frames:


            processed_frames = []


            for frame in frames:

                processed_frames.append(

                    prepare_frame(
                        frame
                    )

                )



            save_settings = {


                "format":
                    "GIF",


                "save_all":
                    True,


                "append_images":
                    processed_frames[1:],


                "duration":
                    duration

            }



        else:


            image = prepare_frame(
                image
            )


            processed_frames = [

                image

            ]


            save_settings = {


                "format":
                    "GIF",


                "duration":
                    duration

            }



        # =====================
        # LOOP
        # =====================


        if loop_mode == "infinite":


            save_settings[
                "loop"
            ] = 0



        else:


            save_settings[
                "loop"
            ] = settings.get(
                "loop_count",
                1
            )



        # =====================
        # TRANSPARENCY
        # =====================


        if transparency:


            save_settings[
                "transparency"
            ] = 0



        # =====================
        # SAVE
        # =====================


        processed_frames[0].save(

            output,

            **save_settings

        )


        return output
