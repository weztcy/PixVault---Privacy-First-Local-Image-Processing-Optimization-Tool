            "transparency",
            True
        )



        image = self.prepare_image(
            image,
            transparency,
            bit_depth
        )



        ico_sizes = []


        for size in sizes:


            ico_sizes.append(

                (
                    size,
                    size
                )

            )



        image.save(

            output,

            format="ICO",

            sizes=ico_sizes

        )


        return output




    def prepare_image(
        self,
        image,
        transparency,
        bit_depth
    ):


        # =====================
        # 32 BIT
        # =====================

        if bit_depth == 32:


            image = image.convert(
                "RGBA"
            )



        # =====================
        # 24 BIT
        # =====================

        elif bit_depth == 24:


            image = image.convert(
                "RGB"
            )


            if transparency:


                background = Image.new(

                    "RGBA",

                    image.size,

                    "white"

                )


                background.paste(
                    image
                )


                image = background.convert(
                    "RGB"
                )



        # =====================
        # 8 BIT
        # =====================

        elif bit_depth == 8:


            image = image.convert(
                "P",
                colors=256
            )



        else:


            image = image.convert(
                "RGBA"
            )



        # =====================
        # REMOVE ALPHA
        # =====================

        if not transparency:


            if image.mode == "RGBA":


                background = Image.new(

                    "RGB",

                    image.size,

                    "white"

                )


                background.paste(

                    image,

                    mask=image.getchannel(
                        "A"
                    )

                )


                image = background



        return image
