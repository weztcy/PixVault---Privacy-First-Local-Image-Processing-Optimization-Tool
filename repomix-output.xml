from pathlib import Path

from datetime import datetime
import re






class NamingEngine:



    FORMAT_EXTENSION = {


        "JPEG":
            "jpg",


        "PNG":
            "png",


        "WEBP":
            "webp",


        "AVIF":
            "avif",


        "GIF":
            "gif",


        "BMP":
            "bmp",


        "TIFF":
            "tiff",


        "HEIC":
            "heic",


        "ICO":
            "ico",


        "SVG":
            "svg"

    }







    def generate(
        self,
        source_path,
        output_folder,
        settings
    ):


        source = Path(
            source_path
        )


        output_folder = Path(
            output_folder
        )


        output_folder.mkdir(
            parents=True,
            exist_ok=True
        )



        filename = self.create_filename(

            source,

            settings

        )



        return self.resolve_collision(

            output_folder / filename

        )







    def normalize_extension(
        self,
        format_name
    ):


        if not format_name:

            return None



        format_name = str(
            format_name
        ).upper().lstrip(".")



        extension = self.FORMAT_EXTENSION.get(
            format_name
        )



        if not extension:

            raise ValueError(

                f"Unsupported format: {format_name}"

            )



        return extension







    def sanitize_name(
        self,
        value
    ):


        value = str(
            value
        )


        value = re.sub(

            r'[<>:"/\\|?*]',

            "_",

            value

        )


        value = re.sub(

            r"\s+",

            "_",

            value

        )


        return value.strip("_")







    def create_filename(
        self,
        source,
        settings
    ):


        format_name = settings.get(
            "format"
        )



        extension = self.normalize_extension(
            format_name
        )



        if not extension:

            extension = source.suffix.replace(
                ".",
                ""
            )



        name = self.sanitize_name(
            source.stem
        )



        pattern = settings.get(
            "pattern"
        )


        suffix = settings.get(
            "suffix"
        )



        if pattern:


            filename = pattern.format(

                name=name,

                format=format_name,

                date=datetime.now().strftime(
                    "%Y-%m-%d"
                )

            )


            filename = self.sanitize_name(
                filename
            )


            if not filename.lower().endswith(
                f".{extension}"
            ):

                filename += f".{extension}"



            return filename







        if suffix:


            suffix = self.sanitize_name(
                suffix
            )


            name += (
                "_"
                +
                suffix
            )



        return (

            name

            +

            "."

            +

            extension

        )







    def resolve_collision(
        self,
        output_path
    ):


        if not output_path.exists():

            return output_path



        counter = 1



        while True:


            new_path = output_path.parent / (

                f"{output_path.stem}_"

                f"{counter:03d}"

                f"{output_path.suffix}"

            )



            if not new_path.exists():

                return new_path



            counter += 1
