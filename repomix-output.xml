from pathlib import Path

from PIL import Image

from formats import BaseEncoder




class AVIFEncoder(BaseEncoder):


    def save(
        self,
        image,
        output_path,
        settings
    ):


        output = Path(
            output_path
        )



        # =====================
        # SETTINGS
        # =====================


        lossless = settings.get(
            "lossless",
            False
        )


        quality = settings.get(
            "quality",
            80
        )


        speed = settings.get(
            "speed",
            6
        )


        subsampling = settings.get(
            "subsampling",
            "4:2:0"
        )


        alpha = settings.get(
            "alpha",
            True
        )



        # =====================
        # VALIDATION
        # =====================


        quality = max(
            0,
            min(
                100,
                int(quality)
            )
        )


        speed = max(
            0,
            min(
                10,
                int(speed)
            )
        )


        valid_subsampling = [

            "4:4:4",
            "4:2:2",
            "4:2:0"

        ]


        if subsampling not in valid_subsampling:

            subsampling = "4:2:0"



        # =====================
        # IMAGE MODE
        # =====================


        if alpha:


            if image.mode not in [

                "RGBA"

            ]:


                if "A" in image.getbands():

                    image = image.convert(
                        "RGBA"
                    )

                else:

                    image = image.convert(
                        "RGBA"
                    )


        else:


            if image.mode != "RGB":

                image = image.convert(
                    "RGB"
                )



        # =====================
        # SAVE OPTIONS
        # =====================


        save_options = {


            "format":
                "AVIF",


            "lossless":
                bool(lossless),


            "speed":
                speed,


            "subsampling":
                subsampling

        }



        # Lossy
        if not lossless:


            save_options[
                "quality"
            ] = quality



        else:


            save_options[
                "quality"
            ] = 100



        # Alpha channel
        #
        # Pillow AVIF encoder mengikuti
        # mode image untuk alpha.
        #
        # Jadi alpha tidak dikirim
        # sebagai parameter save.
        #


        image.save(
            output,
            **save_options
        )



        return output
