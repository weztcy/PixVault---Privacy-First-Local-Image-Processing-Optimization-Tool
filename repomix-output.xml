from formats.jpeg import JPEGEncoder
from formats.png import PNGEncoder
from formats.webp import WEBPEncoder
from formats.avif import AVIFEncoder
from formats.gif import GIFEncoder
from formats.bmp import BMPEncoder
from formats.tiff import TIFFEncoder
from formats.heic import HEICEncoder
from formats.ico import ICOEncoder
from formats.svg import SVGEncoder






class EncoderManager:



    def __init__(
        self
    ):


        jpeg = JPEGEncoder()

        png = PNGEncoder()

        webp = WEBPEncoder()

        avif = AVIFEncoder()

        gif = GIFEncoder()

        bmp = BMPEncoder()

        tiff = TIFFEncoder()

        heic = HEICEncoder()

        ico = ICOEncoder()

        svg = SVGEncoder()



        self.encoders = {


            "JPEG":
                jpeg,


            "PNG":
                png,


            "WEBP":
                webp,


            "AVIF":
                avif,


            "GIF":
                gif,


            "BMP":
                bmp,


            "TIFF":
                tiff,


            "HEIC":
                heic,


            "ICO":
                ico,


            "SVG":
                svg

        }







    def normalize_format(
        self,
        format_name
    ):


        if not format_name:

            raise ValueError(
                "Output format is missing"
            )



        format_name = str(
            format_name
        ).strip().upper()



        format_name = format_name.lstrip(
            "."
        )



        aliases = {


            "JPG":
                "JPEG",


            "JPE":
                "JPEG",


            "JFIF":
                "JPEG",


            "TIF":
                "TIFF",


            "HEIF":
                "HEIC"

        }



        return aliases.get(
            format_name,
            format_name
        )







    def get_encoder(
        self,
        format_name
    ):


        normalized = self.normalize_format(
            format_name
        )



        encoder = self.encoders.get(
            normalized
        )



        if encoder is None:

            raise ValueError(

                f"Unsupported encoder format: {normalized}"

            )



        return encoder







    def save(
        self,
        image,
        output_path,
        settings
    ):


        if not settings:

            raise ValueError(
                "Encoder settings are empty"
            )



        format_name = self.normalize_format(

            settings.get(
                "format"
            )

        )



        encoder = self.get_encoder(
            format_name
        )



        encoder_settings = dict(
            settings
        )


        encoder_settings["format"] = format_name



        return encoder.save(

            image,

            output_path,

            encoder_settings

        )
