from PIL import Image

from formats import BaseEncoder




class JPEGEncoder(BaseEncoder):


    def save(
        self,
        image,
        output_path,
        settings
    ):


        output = Path(
            output_path
        )



        quality = settings.get(
            "quality",
            85
        )


        progressive = settings.get(
            "progressive",
            False
        )


        optimize = settings.get(
            "optimize",
            True
        )


        subsampling = settings.get(
            "subsampling",
            "4:2:0"
        )



        # =====================
        # VALIDATE QUALITY
        # =====================


        quality = max(
            0,
            min(
                100,
                int(quality)
            )
        )



        # =====================
        # MAP SUBSAMPLING
        # Pillow:
        #
        # 0 = 4:4:4
        # 1 = 4:2:2
        # 2 = 4:2:0
        # =====================


        subsampling_map = {


            "4:4:4":
                0,


            "4:2:2":
                1,


            "4:2:0":
                2

        }



        subsampling = subsampling_map.get(
            subsampling,
            2
        )



        # =====================
        # COLOR CONVERSION
        # =====================


        if image.mode in [
            "RGBA",
            "LA"
        ]:


            background = Image.new(
                "RGB",
                image.size,
                "white"
            )


            background.paste(
                image,
                mask=image.getchannel(
                    "A"
                )
            )


            image = background



        elif image.mode != "RGB":


            image = image.convert(
                "RGB"
            )



        # =====================
        # SAVE JPEG
        # =====================


        image.save(

            output,

            format="JPEG",

            quality=quality,

            progressive=bool(
                progressive
            ),

            optimize=bool(
                optimize
            ),

            subsampling=subsampling

        )



        return output
