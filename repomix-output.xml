from pathlib import Path

from PIL import Image





class MetadataProcessor:



    def process(
        self,
        source_path,
        output_path,
        settings
    ):


        source = Path(
            source_path
        )


        output = Path(
            output_path
        )


        output.parent.mkdir(
            parents=True,
            exist_ok=True
        )



        if not source.exists():

            raise FileNotFoundError(
                f"Source image not found: {source}"
            )



        mode = settings.get(
            "mode",
            "all"
        )



        with Image.open(source) as image:


            cleaned = self.remove_metadata(

                image,

                mode,

                settings

            )



            cleaned.save(

                output,

                format="TIFF",

                compression="tiff_lzw"

            )



        return output







    def remove_metadata(
        self,
        image,
        mode,
        settings
    ):


        clean = image.copy()



        # =====================
        # REMOVE ALL
        # =====================

        if mode == "all":


            clean.info.clear()


            exif = clean.getexif()


            exif.clear()



            return clean








        # =====================
        # CUSTOM REMOVE
        # =====================

        if mode == "custom":


            remove_keys = settings.get(

                "remove",

                []

            )



            if "all" in remove_keys:


                clean.info.clear()


                clean.getexif().clear()


                return clean






            if "exif" in remove_keys:


                clean.getexif().clear()






            if "icc_profile" in remove_keys:


                clean.info.pop(

                    "icc_profile",

                    None

                )






            if "dpi" in remove_keys:


                clean.info.pop(

                    "dpi",

                    None

                )






            if "comment" in remove_keys:


                clean.info.pop(

                    "comment",

                    None

                )



            return clean






        raise ValueError(

            f"Unsupported metadata mode: {mode}"

        )







    def get_metadata(
        self,
        image_path
    ):


        image_path = Path(
            image_path
        )


        with Image.open(image_path) as image:


            return {


                "format":

                    image.format,


                "mode":

                    image.mode,


                "size":

                    image.size,


                "info":

                    dict(
                        image.info
                    ),


                "exif":

                    dict(
                        image.getexif()
                    )

            }
