        )


        layout.addWidget(
            privacy_box
        )


        layout.addWidget(
            start_button
        )


        self.setLayout(
            layout
        )



    def open_processing(
        self
    ):

        parent = self.parentWidget()


        while parent:

            if hasattr(
                parent,
                "show_page"
            ):

                parent.show_page(
                    "all_processing"
                )

                return


            parent = parent.parentWidget()
