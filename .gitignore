# Python bytecode and compiled extensions
__pycache__/
*.py[cod]
*.so
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging and build output
/build/
/dist/
*.egg-info/
.eggs/
*.egg

# Tests, coverage, and development caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
.cache/

# Editor and operating system files
.vscode/
.idea/
*.sublime-workspace
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Local configuration and secrets
.env
.env.*
!.env.example
!.env.sample
/config.local.json

# Processing history may contain private file paths
# Keep history/ Python source files tracked
/history/*.json
/history/*.json.*
/history/*.db
/history/*.db-*
/history/*.sqlite
/history/*.sqlite3
/history/*.sqlite*-*

# Local images and generated output
# Use these folders for private inputs and processing results
# Do not ignore /export/: it contains application source code
/input/
/inputs/
/output/
/outputs/
/exports/
/processed/
/preview/
/thumbnails/
/temp/
/tmp/
/private/

# Logs
*.log
/logs/

# Generated repository bundles
/repomix-output.*

# Keep application assets, ICC profiles, Qt resource sources,
# dependency lockfiles, and PyInstaller .spec files tracked.
# Image extensions are intentionally not ignored globally.
